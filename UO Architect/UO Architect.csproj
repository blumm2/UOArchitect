<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>UOArchitect</RootNamespace>
    <AssemblyName>UO Architect</AssemblyName>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <StartupObject>UOArchitect.UOARToolBox</StartupObject>
    <!-- keep the WinForms 1.x look and layout of the original forms -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- .resx images/icons are stored as byte arrays (TypeConverter), no BinaryFormatter needed -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <!-- legacy 2005 code: designer serialization hints and Closing/Closed events are left as they are -->
    <NoWarn>$(NoWarn);WFO1000;WFDEV004</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- other projects and files that were never part of the client build -->
    <Compile Remove="UOArchitectInterfaces/**" />
    <EmbeddedResource Remove="UOArchitectInterfaces/**" />
    <None Remove="UOArchitectInterfaces/**" />
    <Compile Remove="RunUO Scripts/**" />
    <Compile Remove="Deployment/**" />
    <Compile Remove="frmMapDisplay.cs;HideableContainerBar.cs;IO/DesignFileHeader.cs" />
    <EmbeddedResource Remove="frmMapDisplay.resx;HideableContainerBar.resx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrbScriptServerSDK\OrbServerSDK.csproj" />
    <ProjectReference Include="UOArchitectInterfaces\UOArchitectInterface.csproj" />
    <ProjectReference Include="..\Ultima\Ultima\Ultima.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- runtime data next to the executable -->
    <None Include="Internal/**" Exclude="Internal/**/*.scc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Seed design database: copied only when the output has none yet, so a rebuild
       never overwrites the designs the user saved there. -->
  <Target Name="CopySeedDesigns" AfterTargets="Build">
    <ItemGroup>
      <SeedDesign Include="Data/Save/*" />
    </ItemGroup>
    <Copy SourceFiles="@(SeedDesign)" DestinationFolder="$(OutDir)Save" Condition="!Exists('$(OutDir)Save/Designs.idx')" />
  </Target>
</Project>
