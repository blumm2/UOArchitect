<Project Sdk="Microsoft.NET.Sdk">
  <!-- Orb connection (client + server side). Plain net10.0: runs on Windows, Linux, ARM64. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OrbServerSDK</RootNamespace>
    <AssemblyName>OrbServerSDK</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- server script and the legacy sample client are not part of the library -->
    <Compile Remove="Orb UOAR Server Script/**" />
    <Compile Remove="UOAR Server sample client/**" />
    <EmbeddedResource Remove="UOAR Server sample client/**" />
    <None Remove="UOAR Server sample client/**" />
  </ItemGroup>
</Project>
